# Copy this file to .env.local and fill in real values.

# Supabase — Settings → API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — resend.com → API Keys
RESEND_API_KEY=re_xxx
# Verified sending address (e.g. "BBM Leave <leave@blackbird.marketing>")
RESEND_FROM="BBM Leave <leave@blackbird.marketing>"

# Public site URL — used in email links. Update on Vercel after deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Slack daily out-of-office digest (optional) — see README section 7 ---
# Slack is connected from inside the app: Admin -> Integrations -> Connect.
# The three SLACK_* variables below are only a bootstrap, read when no
# integration_settings row exists yet. Once an admin presses Connect or Save
# the stored row wins and these are ignored.
SLACK_BOT_TOKEN=
# Channel ID (not the name) — right-click the channel -> View channel details,
# the ID is at the bottom of the About tab. Looks like C0123456789.
SLACK_CHANNEL_ID=
# Hour of day (0-23, Kosovo time) the digest posts. Defaults to 6.
SLACK_DAILY_POST_HOUR=
# Shared secret Vercel Cron sends with every trigger, so nobody else can make
# the bot post. Required for the digest. Generate one with: openssl rand -hex 32
CRON_SECRET=
