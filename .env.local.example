# Copy this file to .env.local and fill in real values.

# Supabase — Settings → API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — resend.com → API Keys
RESEND_API_KEY=re_xxx
# Verified sending address (e.g. "BBM Leave <leave@blackbird.marketing>")
RESEND_FROM="BBM Leave <leave@blackbird.marketing>"

# Public site URL — used in email links. Update on Vercel after deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Slack daily out-of-office digest (optional) — see README section 7 ---
# Bot User OAuth Token from your Slack app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
# Channel ID (not the name) — right-click the channel → View channel details,
# the ID is at the bottom of the About tab. Looks like C0123456789.
SLACK_CHANNEL_ID=
# Hour of day (0–23, Europe/Dublin) the digest posts. Defaults to 9.
SLACK_DAILY_POST_HOUR=9
# Shared secret Vercel Cron sends with every trigger, so nobody else can make
# the bot post. Generate one with: openssl rand -hex 32
CRON_SECRET=
