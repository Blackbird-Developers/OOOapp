# Copy this file to .env.local and fill in real values.

# Supabase — Settings → API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — resend.com → API Keys
RESEND_API_KEY=re_xxx
# Verified sending address (e.g. "BBM Leave <leave@blackbird.marketing>")
RESEND_FROM="BBM Leave <leave@blackbird.marketing>"

# Public site URL — used in email links. Update on Vercel after deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Slack daily out-of-office digest (optional) — see README section 7 ---
# Slack is connected from inside the app: Admin -> Integrations -> Connect.
# The three SLACK_* variables below are only a bootstrap, read when no
# integration_settings row exists yet. Once an admin presses Connect or Save
# the stored row wins and these are ignored.
SLACK_BOT_TOKEN=
# Channel ID (not the name) — right-click the channel -> View channel details,
# the ID is at the bottom of the About tab. Looks like C0123456789.
SLACK_CHANNEL_ID=
# Hour of day (0-23, Kosovo time) the digest posts. Defaults to 6.
SLACK_DAILY_POST_HOUR=
# Shared secret Vercel Cron sends with every trigger, so nobody else can make
# the bot post. Required for the digest. Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Gmail out-of-office auto-reply (optional) — see README section 12 ---
# A Google Workspace service account with domain-wide delegation for the scope
# https://www.googleapis.com/auth/gmail.settings.basic. That scope reads and
# writes mailbox SETTINGS only — it cannot read, send or delete any message.
# The integration is switched on from inside the app: Admin -> Integrations.
#
# From the service account JSON key file you download from Google Cloud:
GOOGLE_SA_CLIENT_EMAIL=
# The key file's private_key. One long value containing newlines — paste it
# verbatim, or with the \n escapes exactly as they appear in the JSON. Both
# parse. Never commit this.
GOOGLE_SA_PRIVATE_KEY=
# Safety rail: the app refuses to act on any address outside this domain,
# which turns a confusing Google error into a clear skip. e.g. blackbird.marketing
GOOGLE_WORKSPACE_DOMAIN=
